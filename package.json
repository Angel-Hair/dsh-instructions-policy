{
  "name": "dsh-instructions-policy",
  "version": "0.6.0",
  "description": "Session-scoped policy for DSH workspace instructions: choose the root AGENTS.md, toggle user-global instructions, toggle subdirectory discovery.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agents-md",
    "instructions"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-client.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.build.json && node scripts/copy-client.mjs",
    "test": "node tests/policy.test.mjs && node tests/projection.test.mjs && node tests/client.test.mjs && node tests/contract.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angel-Hair/dsh-instructions-policy.git"
  },
  "homepage": "https://github.com/Angel-Hair/dsh-instructions-policy#readme",
  "bugs": {
    "url": "https://github.com/Angel-Hair/dsh-instructions-policy/issues"
  },
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <1.0.0-0"
  }
}
